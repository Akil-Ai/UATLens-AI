# UATlens AI Environment Configuration
# Select LLM Provider: "anthropic" or "gemini" (or "mock" for fully offline demo mode)
LLM_PROVIDER=anthropic

# Model configuration (do not hardcode in code)
# For Anthropic: claude-3-5-sonnet-20241022 or claude-3-7-sonnet-latest
# For Gemini: gemini-2.0-flash or gemini-1.5-pro
LLM_MODEL=claude-3-5-sonnet-20241022

# API Keys (put your key here - never commit to git)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
DATABASE_URL=sqlite:///./uatlens.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
