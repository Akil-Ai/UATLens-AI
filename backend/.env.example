# ==============================================================================
# UATlens AI Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider: "anthropic" or "gemini" (or "mock" for fully offline demo mode)
LLM_PROVIDER=anthropic

# Model name:
# For Anthropic: claude-3-5-sonnet-20241022 or claude-3-7-sonnet-latest
# For Gemini: gemini-2.0-flash or gemini-1.5-pro
LLM_MODEL=claude-3-5-sonnet-20241022

# API Keys (Never commit keys or real credentials to git)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# For local SQLite development (default):
# DATABASE_URL=sqlite:///./uatlens.db

# For Supabase PostgreSQL (Application Runtime):
# Connect using direct connection or Session Pooler (port 5432).
# Driver: psycopg 3 (automatically normalized to postgresql+psycopg://).
# Note: If your password contains special characters (e.g. '@', '#', '$'), URL-encode them.
# Example direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Example session pooler (IPv4 / connection pooling):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./uatlens.db

# Schema Migration Connection URL (Alembic):
# Must use Direct connection or Session Pooler (port 5432).
# DO NOT use Transaction Pooler (port 6543) for DDL migrations.
# If omitted, defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# SQLite Source Path (for data migration script):
# Path to existing SQLite database to migrate into Supabase PostgreSQL.
# If omitted, auto-discovers uatlens.db from repository root.
# SQLITE_SOURCE_PATH=./uatlens.db

# Database Connection Pool Settings (PostgreSQL only):
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
DB_REQUIRE_SSL=True
DB_SCHEMA=public

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

